Thumbs.db

# Agent working notes. Untracked by default: `.claude/memory/` holds notes on
# how Andrea likes to work, and this is a public repo. Delete these two lines
# to publish them — they are ordinary markdown and nothing depends on them
# being ignored.
.claude/memory/
.claude/handoffs/
.claude/overnight/

# Private journal (local thinking notes, never committed)
.private-journal/

# Eval runner output: transcripts and the HTML report (issue #52). Never committed.
evals/results/

# --- AI assistant files (local only, never published) ---
# Anchored entries (/NAME) are root-only on purpose: a nested AGENTS.md or
# CLAUDE.md can belong to the project's own content and must stay tracked.
.claude/
/CLAUDE.md
/CLAUDE.local.md
/AGENTS.md
/GEMINI.md
